PORT=3000
DATABASE_URL=postgresql://postgres:root@localhost:5432/cms_site_db
JWT_SECRET=change-me-in-production
CORS_ORIGIN=*
CMS_PUBLIC_URL=http://localhost:3000
WORKSPACES_DIR=../workspaces
COMPONENT_PREVIEW_DIR=../workspaces/component-preview
COMPONENT_PREVIEW_DEV_PORT=4322
COMPONENT_PREVIEW_DEV_HOST=localhost
# Browser-facing HTTPS URL (nginx reverse proxy). Leave unset for local HTTP preview.
# COMPONENT_PREVIEW_PUBLIC_URL=https://custom-cms-staging.nevox.cloud/__component-preview
COMPONENT_PREVIEW_ASSETS_DIR=../component-preview-assets
ASTRO_STARTER_DIR=../astro-starter
SITE_DEV_PORT_BASE=4500
SITE_DEV_HOST=localhost

# SMTP for form submission notifications (optional)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com
SMTP_SECURE=false
